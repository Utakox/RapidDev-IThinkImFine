%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daecc414a082f8c4aafa1df04beefc1e, type: 3}
  m_Name: Character_2
  m_EditorClassIdentifier: Assembly-CSharp::CharacterData
  characterName: Hikiko
  startingSanity: 40
  introNarration:
    enabled: 1
    lines:
    - text: "Subject 02 sits across from you. \n\nShe is twenty-two years old, with
        blank eyes and dried paint on her pale fingers. Growing up as an orphan,
        art was her only way to feel like she had a place in the world. She poured
        her soul into her paintings and shared them online, begging for someone anyone
        to notice her. But the internet gave her nothing but pure silence. Zero likes.
        Zero comments. \n\nNow, the quiet in the room is heavy and suffocating. Will
        you pull her out of the dark, or let her fade away into nothing?"
      typeSpeed: 0.07
      delayAfter: 0
      clearBefore: 0
    typingLoopClip: {fileID: 8300000, guid: ab9b8e50d1b25f843a136ef6473c196c, type: 3}
    typingVolume: 1
    stopSoundBetweenLines: 0
    holdAfterFinish: 2.5
    ambienceOneShot: {fileID: 0}
  inspectSprite: {fileID: -5576717459837320655, guid: 7d95762fe86e8ae4ca5797ce4b480f90, type: 3}
  portraitSprite: {fileID: -1392292194018032339, guid: 5d69f9deae48782449a485960233f31e, type: 3}
  faceHigh: {fileID: -3610208547073541062, guid: 47bce665a7e1d584fb0113654a4853d3, type: 3}
  faceMid: {fileID: -7146858243547931844, guid: 8531be498a05673449b931367685f8d0, type: 3}
  faceLow: {fileID: -7901941117833382281, guid: 5da989742a111e241a34fe2a2a7dbffb, type: 3}
  faceBroken: {fileID: -409418157473551590, guid: 15881f90b2f693e438d0452a5db9c08b, type: 3}
  introDialogue:
  - text: (She wraps her arms tightly around herself, paint-stained fingers digging
      into her sleeves. Her blank eyes stare right through you. Her voice is monotonous,
      completely hollow)
    typeSpeedOverride: 0.06
    delayAfterOverride: -1
    shakeText: 0
    shakeIntensity: 1
    typingLoopOverride: {fileID: 0}
  - text: Do you hear it, Doctor? The silence? It's so suffocating... like static
      screaming inside my head.
    typeSpeedOverride: 0.06
    delayAfterOverride: -1
    shakeText: 0
    shakeIntensity: 1
    typingLoopOverride: {fileID: 0}
  - text: I don't have a family to go back to. I don't have friends who check on
      me. My canvas was the only place where I actually existed... but when I post
      my work online, it's just zero
    typeSpeedOverride: 0.06
    delayAfterOverride: -1
    shakeText: 0
    shakeIntensity: 1
    typingLoopOverride: {fileID: 0}
  - text: Zero likes. Zero views. Zero comments. It's like typing a message to an
      empty universe
    typeSpeedOverride: 0.06
    delayAfterOverride: -1
    shakeText: 0
    shakeIntensity: 1
    typingLoopOverride: {fileID: 0}
  - text: Millions of people scrolling past me, and not a single one knows I'm breathing.
    typeSpeedOverride: 0.06
    delayAfterOverride: -1
    shakeText: 0
    shakeIntensity: 1
    typingLoopOverride: {fileID: 0}
  - text: If nobody sees what I create, and nobody cares that I'm here... do I even
      exist? Or am I just a glitch waiting to be deleted?
    typeSpeedOverride: 0.06
    delayAfterOverride: -1
    shakeText: 0
    shakeIntensity: 1
    typingLoopOverride: {fileID: 0}
  sanityDialogueTriggers:
  - note: 
    threshold: 0
    compare: 0
    dialogue: []
  goodChoices:
  - choiceText: Inquire why she chose cerulean blue for the unposted sketch on her
      tablet.
    sanityChange: 20
    doctorSanityChange: 0
    afterDialogue:
    - text: (She pauses, her paint-stained fingers lightly tracing the screen.)
      typeSpeedOverride: -1
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 1
      typingLoopOverride: {fileID: 0}
    - text: This blue... it's what I saw from the orphanage window. It proves I was
        actually there.
      typeSpeedOverride: -1
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 1
      typingLoopOverride: {fileID: 0}
  - choiceText: Gently ask her to remove her headphones and be present in the room.
    sanityChange: 20
    doctorSanityChange: 0
    afterDialogue:
    - text: (She slowly pulls one earcup back, letting the static bleed out.)
      typeSpeedOverride: -1
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 1
      typingLoopOverride: {fileID: 0}
    - text: It's the sound of chaos... It's safer than the silence. The silence tells
        me no one wants me.
      typeSpeedOverride: -1
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 1
      typingLoopOverride: {fileID: 0}
  - choiceText: Request she turn off the screen so you can observe her actual physical
      canvas instead.
    sanityChange: 20
    doctorSanityChange: 0
    afterDialogue:
    - text: (She slowly turns off the screen, staring at the stubborn paint stains
        on her fingertips.)
      typeSpeedOverride: -1
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 1
      typingLoopOverride: {fileID: 0}
    - text: It's messy. It's imperfect... But it's real, isn't it, Doctor?
      typeSpeedOverride: -1
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 1
      typingLoopOverride: {fileID: 0}
  - choiceText: Ask her to point out one part of the canvas she would keep, even
      if no one else ever saw it.
    sanityChange: 20
    doctorSanityChange: 0
    afterDialogue:
    - text: (She studies the canvas quietly, then traces a small blue stroke with
        her finger.)
      typeSpeedOverride: -1
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 1
      typingLoopOverride: {fileID: 0}
    - text: This part... I painted it because I liked it.
      typeSpeedOverride: -1
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 1
      typingLoopOverride: {fileID: 0}
    - text: I guess that used to be enough.
      typeSpeedOverride: -1
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 1
      typingLoopOverride: {fileID: 0}
  badChoices:
  - choiceText: Suggest she analyze popular AI art to adapt her style for better
      algorithm engagement.
    sanityChange: -20
    doctorSanityChange: 15
    afterDialogue:
    - text: (She grips the tablet until her knuckles turn white, eyes trembling.)
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
    - text: Adapt... If my soul isn't enough, and I have to copy a machine... why
        do I even exist?
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  - choiceText: Note that her white noise is just another algorithmically generated
      sound, same as AI art.
    sanityChange: -20
    doctorSanityChange: 15
    afterDialogue:
    - text: (Her breath hitches. She violently presses the headphones against her
        skull.)
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
    - text: No! This is my hiding place! If even this is fake... where am I supposed
        to go?!
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  - choiceText: Advise her to read the critiques objectively to find actionable data
      for improvement.
    sanityChange: -20
    doctorSanityChange: 15
    afterDialogue:
    - text: (Her eyes dart across the cruel comments, absorbing every 'trash' and
        'worthless' until she shrinks back into the abandoned orphan she always was.)
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  - choiceText: Ask her which criticisms were correct and what she should fix first.
    sanityChange: -20
    doctorSanityChange: 15
    afterDialogue:
    - text: (Her eyes return to the comments. She begins picking apart the painting
        piece by piece.)
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
    - text: The colors are wrong... the composition is weak...
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
    - text: Maybe there really isn't anything here worth keeping.
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  sanityThreshold: 29
  crisisChoices:
  - choiceText: Advise her that true artistic freedom means deleting all her accounts
      and disappearing completely.
    sanityChange: 0
    doctorSanityChange: 0
    afterDialogue:
    - text: (Her eyes go dead. After deleting her accounts, she frantically claws
        the paint off her arms to erase herself entirely.)
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 1
      shakeIntensity: 8
      typingLoopOverride: {fileID: 0}
  - choiceText: Conclude that if she refuses to adapt to the digital age, she should
      just turn the volume up and accept isolation.
    sanityChange: 0
    doctorSanityChange: 0
    afterDialogue:
    - text: (Cranking the deafening static to the max, she curls into a tight ball,
        fully accepting her fate as invisible digital trash.
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 1
      shakeIntensity: 8
      typingLoopOverride: {fileID: 0}
  goodEndingChoices:
  - choiceText: Ask if you can keep one of her physical sketches for your office
      wall
    sanityChange: 0
    doctorSanityChange: 0
    afterDialogue:
    - text: (Taking off her headphones, she hands you a torn page.)
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
    - text: This... is the first time anyone wanted to keep a part of me.
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  - choiceText: Offer to sit in comfortable silence while she draws, proving she
      doesn't need to perform for an audience.
    sanityChange: 0
    doctorSanityChange: 0
    afterDialogue:
    - text: This... is the first time anyone wanted to keep a part of me.
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  mentalStateThreshold: 29
  mentalStateClipOverride: {fileID: 0}
  goodEndingNarration:
    enabled: 1
    lines:
    - text: "By looking at the paint on her hands, you proved to her that she is
        real. The terrible silence of being unwanted has finally been broken. She
        deleted all her social media accounts, choosing to stop screaming into an
        internet that never listens. \n\nWhile she still carries the deep sadness
        of an orphaned child, she no longer hides from the world. For the first time,
        she paints simply because she wants to not to prove she exists to strangers,
        but because she finally believes she matters."
      typeSpeed: 0.05
      delayAfter: 0
      clearBefore: 0
    typingLoopClip: {fileID: 0}
    typingVolume: 1
    stopSoundBetweenLines: 0
    holdAfterFinish: 2.5
    ambienceOneShot: {fileID: 0}
  crisisEndingNarration:
    enabled: 1
    lines:
    - text: "Your cold words confirmed her deepest fear: she is completely invisible
        to the world. Pushed past her breaking point, she deleted every trace of
        her art online, accepting her fate as worthless digital trash. Now locked
        in a psychiatric ward, she shrinks into the darkest corner of her room. \n\nHer
        mind has completely shattered. She sits alone in the dead silence, scratching
        at her own arms until they bleed, desperately trying to erase the last physical
        traces of a girl who was never truly there."
      typeSpeed: 0.05
      delayAfter: 0
      clearBefore: 0
    typingLoopClip: {fileID: 8300000, guid: ab9b8e50d1b25f843a136ef6473c196c, type: 3}
    typingVolume: 1
    stopSoundBetweenLines: 0
    holdAfterFinish: 2.5
    ambienceOneShot: {fileID: 0}
