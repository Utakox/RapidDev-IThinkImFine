  m_EditorClassIdentifier: Assembly-CSharp::CharacterData
  characterName: Sam
  startingSanity: 50
  introNarration:
    enabled: 1
    lines:
    - text: ddd
      typeSpeed: 0.04
      delayAfter: 0.8
      clearBefore: 0
    typingLoopClip: {fileID: 8300000, guid: 9e68f89e38e555b4a993f6b016f87cf9, type: 3}
    typingVolume: 1
    stopSoundBetweenLines: 0
    holdAfterFinish: 2.5
    ambienceOneShot: {fileID: 0}
  inspectSprite: {fileID: 7701467319694953680, guid: 48db54ba764c3654d9465dd90fb5f4fa, type: 3}
  portraitSprite: {fileID: -2900486277599875826, guid: 1da1a0b0a8edb64499591ebde6b62e81, type: 3}
  faceHigh: {fileID: -3854747056432117878, guid: 1daa36eddfff07246bf297c2238f8c03, type: 3}
  faceMid: {fileID: -4899330942685619882, guid: 65877db9e2a22d049b5015598100c1f0, type: 3}
  faceLow: {fileID: 3034153364746735271, guid: c5126a3f69ba19d40923f84c96276ed6, type: 3}
  faceBroken: {fileID: 2008715730261720130, guid: b8887ed95353399459000c9f9117e6d2, type: 3}
  introDialogue:
  - text: "I didn't even want to come here. My mom gave up a shift at the diner for
      this appointment, which means we\u2019re down eighty bucks just so I can sit
      in this chair. So, I guess I need to get 'fixed' quickly."
    typeSpeedOverride: 0.06
    delayAfterOverride: 2
    shakeText: 0
    shakeIntensity: 6
    typingLoopOverride: {fileID: 0}
  sanityDialogueTriggers: []
  goodChoices:
  - choiceText: You are a human, not a machine. Taking a break is not a betrayal
      to your mother.
    sanityChange: 10
    doctorSanityChange: 0
    afterDialogue:
    - text: (He gulps it down in one go, letting out a long sigh)
      typeSpeedOverride: 0.05
      delayAfterOverride: 4
      shakeText: 0
      shakeIntensity: 6
      typingLoopOverride: {fileID: 0}
    - text: Thank you... I didn't realize how dry my throat was.
      typeSpeedOverride: 0.05
      delayAfterOverride: 4
      shakeText: 0
      shakeIntensity: 6
      typingLoopOverride: {fileID: 0}
  - choiceText: Give him a quiet moment to collect himself.
    sanityChange: 10
    doctorSanityChange: 0
    afterDialogue:
    - text: (He lowers his head, letting out a long, weary sigh)
      typeSpeedOverride: 0
      delayAfterOverride: -1
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  - choiceText: Ask gently about his academic pressure.
    sanityChange: 10
    doctorSanityChange: 0
    afterDialogue:
    - text: (He pulls nervously on his jacket sleeves)
      typeSpeedOverride: 0.08
      delayAfterOverride: 3
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
    - text: If I mess up... my mom's hard work means nothing
      typeSpeedOverride: 0
      delayAfterOverride: 3
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  - choiceText: Reassure him that he is completely safe in this room.
    sanityChange: 10
    doctorSanityChange: 0
    afterDialogue:
    - text: (He slowly unclenches his fists, looking down at his lap)
      typeSpeedOverride: 0.08
      delayAfterOverride: 3
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
    - text: I haven't talked to anyone about this... not even at home.
      typeSpeedOverride: 0.08
      delayAfterOverride: 3
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  badChoices:
  - choiceText: Remind him how much money his mother spends on his education each
      month.
    sanityChange: -80
    doctorSanityChange: 0
    afterDialogue:
    - text: (His face goes pale. He grips his chair)
      typeSpeedOverride: 0.08
      delayAfterOverride: 2
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
    - text: I know... I know every single money she spends on me. I think about it
        every second.
      typeSpeedOverride: 0.08
      delayAfterOverride: 2
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  - choiceText: Point out that none of his classmates seem to notice his absence.
    sanityChange: -5
    doctorSanityChange: 0
    afterDialogue:
    - text: (He crosses his arms defensively, avoiding your gaze)
      typeSpeedOverride: 0.08
      delayAfterOverride: 2
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
    - text: Why would they care? I'm just the invisible guy who's going to fail anyway
      typeSpeedOverride: 0.08
      delayAfterOverride: 2
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  - choiceText: Slide a blank paper forward and order him to draw his exhausted mother.
    sanityChange: -5
    doctorSanityChange: 0
    afterDialogue:
    - text: (His hands shake so violently he drops the pencil)
      typeSpeedOverride: 0.08
      delayAfterOverride: 2
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
    - text: I can't... I don't want to see her face right now. Please, don't make
        me think about her eyes.
      typeSpeedOverride: 0.08
      delayAfterOverride: 2
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  - choiceText: Maintain absolute silence until the pressure forces him to speak.
    sanityChange: -5
    doctorSanityChange: 0
    afterDialogue:
    - text: (He suddenly buries his face in his hands, trembling)
      typeSpeedOverride: 0.08
      delayAfterOverride: 2
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
    - text: I stole money from her purse last night... just to buy coffee to stay
        awake. What kind of son does that to his own mother?
      typeSpeedOverride: 0.08
      delayAfterOverride: 2
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  sanityThreshold: 40
  crisisChoices:
  - choiceText: Order immediate medical isolation
    sanityChange: 0
    doctorSanityChange: 0
    afterDialogue:
    - text: I AM GONNA KILL YOU! DO NOT!
      typeSpeedOverride: 0.07
      delayAfterOverride: -1
      shakeText: 1
      shakeIntensity: 5
      typingLoopOverride: {fileID: 0}
  - choiceText: Tell him he proved himself to be the exact failure his mother sacrificed
      her life to avoid.
    sanityChange: 0
    doctorSanityChange: 0
    afterDialogue:
    - text: YES! EXACTLY! I STOLE HER LIFE! WHY AM I STILL BREATHING? WHY WON'T YOU
        STOP ME?!
      typeSpeedOverride: 0.07
      delayAfterOverride: -1
      shakeText: 1
      shakeIntensity: 5
      typingLoopOverride: {fileID: 0}
  goodEndingChoices:
  - choiceText: Authorize immediate rest leave and offer to talk to his mother together.
    sanityChange: 0
    doctorSanityChange: 0
    afterDialogue:
    - text: Thank you... I don't remember the last time I didn't feel like I was
        suffocating.
      typeSpeedOverride: 0.08
      delayAfterOverride: 2
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  - choiceText: Reassure him that taking care of his health is the best way to honor
      her effort.
    sanityChange: 0
    doctorSanityChange: 0
    afterDialogue:
    - text: You're right... If I break down here, all her sacrifices mean nothing
        anyway. I'll go sleep.
      typeSpeedOverride: 0.08
      delayAfterOverride: 2
      shakeText: 0
      shakeIntensity: 0
      typingLoopOverride: {fileID: 0}
  mentalStateThreshold: 41
  mentalStateClipOverride: {fileID: 8300000, guid: 457e223f7fe7ade468e3339b38f86894, type: 3}
